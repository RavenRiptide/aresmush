<% if screen_reader %>
<%= title %>.
<%= spoken_equation %>
<% spoken_rows.each do |r| %>
<%= r %>
<% end %>
<% spoken_conditional.each do |r| %>
<%= r %>
<% end %>
<% else %>
<%= header %>
<%= center("#{title_color}#{title}%xn", 78) %>
<%= equation %>
<%= divider %>
<% rows.each do |r| %>
<%= r %>
<% end %>
<% if conditional.any? %>
<%= divider %>
<% conditional.each do |r| %>
<%= r %>
<% end %>
<% end %>
<%= footer %>
<% end %>
