<%= header %>
<%= center("#{title_color}#{title}", 78) %>%xn
<% if any? %>
<% groups.each do |label, names| %>
<%= divider %>
<%= "%b%b#{item_color}#{label}%xn" %>
<% rows(names).each do |row| %>
<%= row %>
<% end %>
<% end %>
<%= divider %>
<%= "%b%b* Puts an effect on you when you use it." %>
<%= "%b%bEnter '%xh%xcaction <name>%xn' for details, or '%xh%xcaction/use <name>%xn' to use the action." %>
<% else %>
<%= "%b%bNone." %>
<% end %>
<%= footer %>
