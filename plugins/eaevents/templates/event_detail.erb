%lh
%xh<%= left( event.title, 30 ) %>%xn

%xh<%= t('events.starts_at_title')%>%xn <%= start_datetime_local %> (<%= start_time_standard %>)
%xh<%= t('events.who_title')%>%xn <%= event.who %>
%xh<%= t('events.tags_title') %>%xn <%= event.content_tags.join(" ") %>
%xh<%= t('eaevents.players_title') %>%xn <%= AresMUSH::EaEvents.players_summary(event) %>
<% if !level_range.blank? %>
%xh<%= t('eaevents.level_range_title') %>%xn <%= level_range %>
<% end %>
<% if event.death_consent %>
%xh%xr<%= t('eaevents.death_consent_title') %>%xn <%= death_consent_line %>
<% end %>

<%= event.description %>
<% if !event.content_warning.blank? %>

%xh%xr<%= t('events.content_warning') %>%xn <%= event.content_warning %>
<% end %>
%ld
%xh<%= t('eaevents.roster_title')%>%xn

<% roster.each_with_index do |s, i| %>
<%= signup_line(s, "#{i+1}.") %>
<% end %>
<% if !average_level.blank? %>

%xh<%= t('eaevents.average_level_title') %>%xn <%= average_level %>
<% end %>
<% if waitlist.any? %>
%ld
%xh<%= t('eaevents.waitlist_title')%>%xn

<% waitlist.each_with_index do |s, i| %>
<%= signup_line(s, "W#{i+1}") %>
<% end %>
<% end %>

%lf
